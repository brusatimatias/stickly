# Postgres (local server)
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/stickly-development?schema=public"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Enable the "Google Calendar API" and add these OAuth scopes:
# openid, email, profile, https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Required for Google sign in. Keep it safe: losing or changing it means every
# user has to sign in with Google again to reconnect Calendar.
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Web chat LLM (Google AI Studio > Get API key). Keep the Cloud project
# WITHOUT a billing account so the free tier quota is a hard cap (429, no charges).
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional: Gemini model for the chat (defaults to gemini-3.5-flash-lite).
# CHAT_MODEL=""
# Optional: Gemini model to retry with once when the main one answers 503
# ("high demand"). Without it, a 503 fails the message.
# CHAT_FALLBACK_MODEL=""

# WhatsApp chat (Meta Cloud API). Use a System User token: the one shown on the
# app's "API Setup" page expires after 24 hours.
WHATSAPP_ACCESS_TOKEN=""
# Stickly's WhatsApp number as users see it, digits only; the profile shows it
# with the link code. Without it the profile hides the WhatsApp section.
WHATSAPP_DISPLAY_NUMBER=""
WHATSAPP_PHONE_NUMBER_ID=""
# App settings > Basic > App secret; verifies the webhook's X-Hub-Signature-256.
WHATSAPP_APP_SECRET=""
# Any random string (e.g. `openssl rand -hex 32`), repeated in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=""

# Push notifications (Web Push). Generate the pair once with
# `npx web-push generate-vapid-keys`; changing it later invalidates every
# device's subscription. Without all three the profile hides notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact for the push services (Apple requires one): an email
# (mailto:you@example.com, or just the address) or the app's https URL.
VAPID_SUBJECT=""

# Reminders and the daily digest (Upstash QStash delivers each one at its
# time to SITE_URL/api/reminders/deliver). Locally, QSTASH_DEV="true" runs
# QStash's dev server instead: no account or keys needed. In production, the
# three values come from console.upstash.com/qstash. Without either, the
# profile hides the reminder settings. Leave them out of Preview deployments:
# QStash would deliver to the production URL.
# QSTASH_DEV="true"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Vercel Cron sends it to /api/reminders/schedule (daily, see vercel.json),
# which queues the next 48 h of reminders. Any random string
# (`openssl rand -hex 32`).
CRON_SECRET=""

# Optional: the app's public URL for absolute metadata URLs (Open Graph image).
# A value without a protocol is taken as https.
# Defaults to Vercel's production domain, then http://localhost:3000.
# SITE_URL=""
