# Postgres (local server)
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/stickly-development?schema=public"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Enable the "Google Calendar API" and add these OAuth scopes:
# openid, email, profile, https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Web chat LLM (Google AI Studio > Get API key). Keep the Cloud project
# WITHOUT a billing account so the free tier quota is a hard cap (429, no charges).
GOOGLE_GENERATIVE_AI_API_KEY=""
