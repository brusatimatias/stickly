// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  googleId      String         @unique
  email         String         @unique
  name          String?
  imageUrl      String?
  avatarUrl     String?
  password      String?
  /// IANA zone reported by the user's browser (e.g. America/Argentina/Buenos_Aires).
  /// Only used to work out "today" and to build Calendar events; note dates and
  /// times are stored as written, not converted.
  timeZone      String?
  notes         Note[]
  webChatUsages WebChatUsage[]
  createdAt     DateTime       @default(now())
}

model Note {
  id            String    @id @default(cuid())
  title         String
  location      String?
  description   String?
  /// Calendar day and wall-clock time as the user wrote them, without a time
  /// zone. `date` is null only for the draft note; `time` (HH:mm) is null when
  /// the note has no time.
  date          DateTime? @db.Date
  time          String?   @db.VarChar(5)
  isDraft       Boolean   @default(false)
  isDone        Boolean   @default(false)
  position      Int       @default(0)
  googleEventId String?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, date])
}

/// One row per web chat message, used only to rate-limit the LLM chat
/// (per user and globally, over rolling windows). Rows older than the
/// longest window are pruned by the chat action itself.
model WebChatUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
