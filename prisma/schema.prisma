// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String            @id @default(cuid())
  googleId                   String            @unique
  email                      String            @unique
  name                       String?
  imageUrl                   String?
  avatarUrl                  String?
  password                   String?
  timeZone                   String?
  googleRefreshToken         String?
  googleAccessToken          String?
  googleAccessTokenExpiresAt DateTime?
  /// Linked WhatsApp number, as Meta sends it in `from`: E.164 digits without
  /// the leading "+".
  whatsappNumber             String?           @unique
  notes                      Note[]
  webChatUsages              WebChatUsage[]
  whatsappLinkCode           WhatsAppLinkCode?
  whatsappMessages           WhatsAppMessage[]
  createdAt                  DateTime          @default(now())
}

/// How a note's `startsAt` is read: TIMED notes are an instant, shown in the
/// viewer's time zone; ALL_DAY notes are a calendar day stored as its 00:00 UTC
/// and read in UTC, never converted (so they stay on the same day everywhere).
enum NoteKind {
  TIMED
  ALL_DAY
}

model Note {
  id            String    @id @default(cuid())
  title         String
  location      String?
  description   String?
  /// Null only for the draft note. See `NoteKind` for how to read it, and
  /// `src/lib/schedule.ts` for the only place that converts it.
  startsAt      DateTime? @db.Timestamptz(3)
  kind          NoteKind  @default(ALL_DAY)
  isDraft       Boolean   @default(false)
  isDone        Boolean   @default(false)
  position      Int       @default(0)
  googleEventId String?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, startsAt])
}

/// One row per web chat message, used only to rate-limit the LLM chat
/// (per user and globally, over rolling windows). Rows older than the
/// longest window are pruned by the chat action itself.
model WebChatUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// The pending code a user sends from WhatsApp to link their number (one per
/// user; generating a new one replaces it). Only a keyed hash of the code is
/// stored, so it can be looked up by what the webhook receives.
model WhatsAppLinkCode {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  codeHash  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Every message received by the WhatsApp webhook, linked number or not.
/// Meta may deliver a message more than once, so the webhook records its id
/// before handling it and skips ids it already has. Also rate-limits link
/// code attempts per sender. Pruned after a day.
model WhatsAppInboundMessage {
  wamid         String   @id
  from          String
  /// The message was a link code, which counts toward the sender's attempts.
  isLinkAttempt Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([from, isLinkAttempt, createdAt])
  @@index([createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
}

/// Short WhatsApp conversation history of a linked user, so the assistant can
/// ask for a missing date and use the answer. Turns older than the idle
/// window are deleted before each new message.
model WhatsAppMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
