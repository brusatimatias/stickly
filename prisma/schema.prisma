// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String         @id @default(cuid())
  googleId                   String         @unique
  email                      String         @unique
  name                       String?
  imageUrl                   String?
  avatarUrl                  String?
  password                   String?
  timeZone                   String?
  googleRefreshToken         String?
  googleAccessToken          String?
  googleAccessTokenExpiresAt DateTime?
  notes                      Note[]
  webChatUsages              WebChatUsage[]
  createdAt                  DateTime       @default(now())
}

/// How a note's `startsAt` is read: TIMED notes are an instant, shown in the
/// viewer's time zone; ALL_DAY notes are a calendar day stored as its 00:00 UTC
/// and read in UTC, never converted (so they stay on the same day everywhere).
enum NoteKind {
  TIMED
  ALL_DAY
}

model Note {
  id            String    @id @default(cuid())
  title         String
  location      String?
  description   String?
  /// Null only for the draft note. See `NoteKind` for how to read it, and
  /// `src/lib/schedule.ts` for the only place that converts it.
  startsAt      DateTime? @db.Timestamptz(3)
  kind          NoteKind  @default(ALL_DAY)
  isDraft       Boolean   @default(false)
  isDone        Boolean   @default(false)
  position      Int       @default(0)
  googleEventId String?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, startsAt])
}

/// One row per web chat message, used only to rate-limit the LLM chat
/// (per user and globally, over rolling windows). Rows older than the
/// longest window are pruned by the chat action itself.
model WebChatUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
