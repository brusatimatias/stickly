// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  googleId      String         @unique
  email         String         @unique
  name          String?
  imageUrl      String?
  avatarUrl     String?
  password      String?
  notes         Note[]
  webChatUsages WebChatUsage[]
  createdAt     DateTime       @default(now())
}

model Note {
  id            String    @id @default(cuid())
  title         String
  location      String?
  description   String?
  scheduledAt   DateTime?
  hasTime       Boolean   @default(true)
  isDraft       Boolean   @default(false)
  isDone        Boolean   @default(false)
  position      Int       @default(0)
  googleEventId String?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, scheduledAt])
}

/// One row per web chat message, used only to rate-limit the LLM chat
/// (per user and globally, over rolling windows). Rows older than the
/// longest window are pruned by the chat action itself.
model WebChatUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
